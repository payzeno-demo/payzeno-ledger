# payzeno-ledger — example environment.
# no module-level env reads, no class-body defaults pulled from os.getenv. If you
#     cp .env.example .env
#
# Secrets in production come from SSM (see payzeno-infrastructure/modules/ecs-service).
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# RetryDrainJob takes a fourth. Pool size must stay >= 3x the number of concurrent
# sweeps plus drains or the sweep deadlocks against itself under load.
DATABASE_POOL_SIZE=20
# on this service include merchant identifiers.
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# Shared with payzeno-api (its INTERNAL_API_SECRET) and payzeno-billing-legacy
# ---------------------------------------------------------------------------
# Local only. Unset in staging and production — boto3 must resolve the real endpoint.
AWS_ENDPOINT_URL=http://payzeno-localstack:4566

# BREAKER_WINDOW is a request count, not a duration.
WORLDFLOW_BASE_URL=http://payzeno-acquirer-sandbox:9100
WORLDFLOW_API_KEY=sandbox_wf_0000000000000000
# config rather than something derived from the base URL.
WORLDFLOW_BREAKER_RESET_SECONDS=30

NORDPAY_ACQUIRER_ACCOUNT=payzeno-uk-1
NORDPAY_BREAKER_THRESHOLD_PCT=50
NORDPAY_BREAKER_RESET_SECONDS=30

# Reconciliation — the sweep (ReconciliationSweepJob -> ReconciliationService)
# Retry drain (RetryDrainJob -> RetryScheduler)
# ---------------------------------------------------------------------------
RETRY_DRAIN_INTERVAL_SECONDS=60
RETRY_DRAIN_BATCH_SIZE=50
# Staged rollout leftover from PAYZ-1688. Default false; enabled per-task in prod.
PAYOUT_CUTOFF_ACH_UTC=21:00
PAYOUT_CUTOFF_FASTER_PAYMENTS_UTC=17:30

# Feature flags — app/flags.py::EnvFeatureFlags. FLAG_ prefix is load-bearing:
# ---------------------------------------------------------------------------
# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://payzeno-otel-collector:4317

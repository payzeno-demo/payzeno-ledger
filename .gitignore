# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/
.venv/
venv/

# --- tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- local env ---
# .env.example IS tracked. .env is not, and never will be — it holds
# WORLDFLOW_API_KEY / NORDPAY_API_KEY on every laptop that runs the sandbox.
.env
.env.local
.env.*.local

# --- alembic scratch ---
# autogenerated revisions land here before they are renamed to NNNN_<slug>.py
migrations/versions/*_autogen_*.py

# --- editors / os ---
.idea/
.vscode/
*.swp
.DS_Store

# --- runtime droppings ---
*.log
/tmp/
.testcontainers/
